---
import MainLayout from '../layouts/MainLayout.astro';
import { contentSection, site } from '../lib/content';
const intro = contentSection('Contact Intro');
---
<MainLayout title="Contact">
  <section class="page-intro container"><p class="eyebrow">Start a project</p><div set:html={intro}></div></section>
  <section class="section container"><div class="contact-layout"><div class="contact-details"><h2>Let’s talk.</h2><div><strong>Email</strong><a href={`mailto:${site.email}`}>{site.email}</a></div><div><strong>Phone</strong><a href={`tel:${site.phone}`}>{site.phone}</a></div><div><strong>Based in</strong><span>{site.address}</span></div><div><strong>Service area</strong><span>{site.serviceArea}</span></div><div><strong>Hours</strong><span>{site.hours}</span></div></div><form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain"><h2>Request a quote</h2><div class="field"><label for="name">Name</label><input id="name" name="name" type="text" required /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required /></div><div class="field"><label for="project">Project details</label><textarea id="project" name="project" rows="6" required></textarea></div><button class="button" type="submit">Send inquiry <span aria-hidden="true">↗</span></button></form></div></section>
</MainLayout>
