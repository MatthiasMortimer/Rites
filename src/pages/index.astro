---
import MainLayout from '../layouts/MainLayout.astro';
import { companyName, contentCards, contentSection } from '../lib/content';
const homeIntro = contentSection('Home Intro');
const servicesIntro = contentSection('Services Intro');
const services = contentCards('Services');
---
<MainLayout title="Built with intent" description={`${companyName} is a dependable residential and commercial contractor in the Portland area.`}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Licensed • Insured • Local</p>
        <div set:html={homeIntro} />
        <div class="actions"><a class="button button-primary" href="/contact">Request a quote <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="/services">Explore services</a></div>
        <div class="hero-stats"><div><strong>12+</strong><span>Years of experience</span></div><div><strong>320</strong><span>Projects completed</span></div><div><strong>4.9/5</strong><span>Client satisfaction</span></div></div>
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading" set:html={servicesIntro}></div>
    <div class="card-grid">{services.map((service, index) => <article class="card"><span class="card-number">0{index + 1}</span><h3>{service.title}</h3><div set:html={service.html}></div></article>)}</div>
  </section>
  <section class="section band"><div class="container split"><div><p class="eyebrow">The {companyName} approach</p><h2>Good work should feel clear from day one.</h2></div><div class="section-lead"><p>We pair skilled hands with practical planning, so your project can move forward with fewer surprises and a finish that holds up.</p><a class="button" href="/about">Meet the team <span aria-hidden="true">↗</span></a></div></div></section>
</MainLayout>
