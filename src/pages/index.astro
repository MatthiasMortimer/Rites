---
import Layout from '../layouts/Layout.astro';
import { site, contentSection } from '../lib/content';

const intro = contentSection('Home Intro');
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Trusted contracting services</p>
      <h1>{site.company}</h1>
      <div class="intro" set:html={intro} />
      <div class="cta-row">
        <a class="primary" href="/contact">Request a quote</a>
        <a class="secondary" href="/services">View services</a>
      </div>
    </div>
    <div class="hero-panel">
      <img src={site.heroImage} alt="Contractor work in progress" />
      <div class="meta">
        <span>{site.phone}</span>
        <span>{site.serviceArea}</span>
      </div>
    </div>
  </section>

  <section class="feature-grid">
    <article>
      <h2>Residential upgrades</h2>
      <p>Kitchen, bath, and full-home improvements built around how you live.</p>
    </article>
    <article>
      <h2>Commercial fit-outs</h2>
      <p>Efficient improvements that support teams, customers, and daily operations.</p>
    </article>
    <article>
      <h2>Focused communication</h2>
      <p>Clear scopes, reliable scheduling, and a practical process from start to finish.</p>
    </article>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: center;
    min-height: 62vh;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
  }

  h1 {
    margin: 0.15rem 0 1rem;
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .intro {
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 55ch;
  }

  .intro :global(p) {
    margin: 0;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.6rem;
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.35rem;
    border-radius: 999px;
    font-weight: 700;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .primary {
    background: var(--accent);
    color: white;
  }

  .secondary {
    background: rgba(31, 78, 74, 0.07);
    color: var(--accent-strong);
  }

  .primary:hover,
  .secondary:hover {
    transform: translateY(-1px);
  }

  .hero-panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .hero-panel img {
    display: block;
    width: 100%;
    height: 430px;
    object-fit: cover;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem 1.2rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .feature-grid article {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--line);
    border-radius: 1.2rem;
    padding: 1.4rem;
  }

  .feature-grid h2 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.15rem;
  }

  .feature-grid p {
    margin: 0;
    line-height: 1.7;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .hero,
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }
  }
</style>
