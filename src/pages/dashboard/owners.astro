---
import Layout from '../../layouts/Layout.astro';
import { createStaffAccount, deleteStaffAccount, getStaffAccounts, getSessionFromRequest } from '../../lib/auth';
import '../../styles/dashboard.css';

const session = getSessionFromRequest(Astro.request);

if (!session || session.role !== 'owner') {
  return Astro.redirect('/login?next=/dashboard/owners');
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = String(formData.get('action') ?? '');
  const id = String(formData.get('id') ?? '');
  const name = String(formData.get('name') ?? '');
  const username = String(formData.get('username') ?? '');
  const password = String(formData.get('password') ?? '');
  const role = String(formData.get('role') ?? 'employee') === 'owner' ? 'owner' : 'employee';

  if (action === 'create' && name && username && password) {
    createStaffAccount({ name, username, password, role });
  }
  if (action === 'delete' && id && id !== session.id) {
    deleteStaffAccount(id);
  }

  return Astro.redirect('/dashboard/owners');
}

const accounts = getStaffAccounts();
---

<Layout>
  <section class="owners-shell">
    <div class="header-row">
      <div>
        <p class="eyebrow">Owner area</p>
        <h1>Staff access management</h1>
      </div>
      <a class="back-link" href="/dashboard">Back to dashboard</a>
    </div>
    <div class="forms-grid">
      <div class="panel">
        <h2>Add staff</h2>
        <form method="post">
          <input type="hidden" name="action" value="create" />
          <label>Full name<input name="name" required /></label>
          <label>Username<input name="username" required /></label>
          <label>Password<input name="password" type="password" required /></label>
          <label>Role<select name="role"><option value="employee">Employee</option><option value="owner">Owner</option></select></label>
          <button type="submit">Add account</button>
        </form>
      </div>
      <div class="panel">
        <h2>Existing accounts</h2>
        <div class="list">
          {accounts.map((account) => (
            <div class="account-item">
              <div><strong>{account.name}</strong><p>{account.username} · {account.role}</p></div>
              <form method="post"><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={account.id} /><button type="submit" class="danger">Delete</button></form>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .forms-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 1.2rem; }
  form { display: grid; gap: .9rem; margin-top: 1rem; }
  .list { display: grid; gap: .8rem; margin-top: 1rem; }
  .account-item { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem .9rem; border: 1px solid var(--line); border-radius: .9rem; }
  .account-item p { margin: .2rem 0 0; color: var(--muted); }
  .account-item form { margin: 0; }
  @media (max-width: 860px) { .forms-grid { grid-template-columns: 1fr; } }
</style>
