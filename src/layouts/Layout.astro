---
import { site } from '../lib/content';
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{site.company}</title>
  </head>
  <body>
    <header class="topbar">
      <div class="brand-wrap">
        <a href="/" class="brand">{site.shortName}</a>
      </div>
      <nav class="nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/dashboard">Dashboard</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>{site.company}</strong>
        <p>{site.address}</p>
      </div>
      <div>
        <p>{site.phone}</p>
        <p>{site.email}</p>
      </div>
      <div>
        <p>{site.hours}</p>
        <p>© {currentYear} {site.company}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f1eb;
    --panel: #fffaf5;
    --ink: #1b1b1b;
    --muted: #5c5a56;
    --accent: #1f4e4a;
    --accent-strong: #173d3a;
    --line: rgba(27, 27, 27, 0.14);
    --shadow: 0 18px 34px rgba(19, 28, 31, 0.08);
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Inter, 'Segoe UI', sans-serif;
    color: var(--ink);
    background: linear-gradient(180deg, #f8f5f1 0%, #f1efe9 100%);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 5vw;
    background: rgba(255, 250, 245, 0.88);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
  }

  .brand {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .nav a:hover {
    color: var(--ink);
  }

  main {
    width: min(1100px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .site-footer {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 1rem;
    width: min(1100px, calc(100% - 2rem));
    margin: 0 auto 3rem;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .site-footer p {
    margin: 0.2rem 0;
  }

  @media (max-width: 720px) {
    .topbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-footer {
      grid-template-columns: 1fr;
    }
  }
</style>
